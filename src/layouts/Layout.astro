---
import "@fontsource-variable/outfit";
import "@/styles/globals.css";

const name = "Daniel Robertson";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Daniel Robertson, product software engineer and musician from Austin, Texas"
    />
    <meta
      name="keywords"
      content="software engineer, web developer, javascript, musician, Daniel Robertson"
    />
    <meta name="author" content={name} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} | Product Engineer and Musician</title>
    <script is:inline>
      const theme = localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body
    class="max-w-2xl mx-auto text-zinc-900 dark:text-zinc-100 bg-zinc-50 dark:bg-zinc-900 antialiased"
  >
    <slot />
  </body>
</html>
<style is:global>
  html {
    font-family: "Outfit Variable", sans-serif;
  }

  body {
    padding: 1rem;
    line-height: 1.5;
  }

  * {
    box-sizing: border-box;
  }

  h1, h2, h3 {
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  h1 {
    margin: 1rem 0;
  }

  ::selection {
    background-color: rgba(168, 85, 247, 0.25);
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stagger {
      animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .stagger-1 { animation-delay: 0ms; }
    .stagger-2 { animation-delay: 80ms; }
    .stagger-3 { animation-delay: 160ms; }
    .stagger-4 { animation-delay: 240ms; }
    .stagger-5 { animation-delay: 320ms; }
  }
</style>
