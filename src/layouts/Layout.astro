---
import "@fontsource-variable/outfit";
import "@/styles/globals.css";
import DotBackground from "@/components/DotBackground";

const name = "Daniel Robertson";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${name} | Product Engineer and Musician`,
  description = "Daniel Robertson, product software engineer and musician from Austin, Texas",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="software engineer, web developer, javascript, musician, Daniel Robertson"
    />
    <meta name="author" content={name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", theme === "dark" ? "#18181b" : "#fafafa");
    </script>
  </head>
  <body
    class="relative max-w-2xl mx-auto text-zinc-900 dark:text-zinc-100 bg-zinc-50 dark:bg-zinc-900 antialiased"
  >
    <a
      href="#top"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm dark:focus:bg-zinc-800"
    >
      Skip to content
    </a>
    <DotBackground client:load />
    <slot />
  </body>
</html>
<style is:global>
  body {
    padding: 1rem;
    line-height: 1.5;
  }

  h1 {
    margin: 1rem 0;
  }
</style>
