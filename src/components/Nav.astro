---
interface Props {
  current?: "home" | "places" | "contact";
}

const { current } = Astro.props;

const links = [
  { key: "home", href: "/", label: "home" },
  { key: "places", href: "/places", label: "places" },
  { key: "contact", href: "/contact", label: "contact" },
] as const;

const baseClasses = "nav-link text-sm py-2 -my-2 px-1 -mx-1";
const idleClasses =
  "text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100";
const currentClasses = "text-zinc-900 dark:text-zinc-100";
---

<nav aria-label="Main">
  <ul class="flex items-center gap-5">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={current === link.key ? "page" : undefined}
            class:list={[baseClasses, current === link.key ? currentClasses : idleClasses]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class:list={[baseClasses, idleClasses]}
      >
        resume
      </a>
    </li>
  </ul>
</nav>
