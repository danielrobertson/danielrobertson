---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ThemeToggle from "../components/ThemeToggle";
import ContactForm from "../components/ContactForm";

const name = "Daniel Robertson";
---

<Layout title={`${name} | Contact`} description="Get in touch with Daniel Robertson">
  <header class="stagger stagger-1 flex items-center justify-between pt-10 pb-4">
    <Nav current="contact" />
    <ThemeToggle client:load />
  </header>

  <main id="top">
    <section class="stagger stagger-2 pt-8 md:pt-16 pb-24">
      <ContactForm client:load />
    </section>
  </main>
</Layout>
