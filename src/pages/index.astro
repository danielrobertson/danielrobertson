---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle";
import Socials from "../components/Socials";
import CareerTimeline from "../components/CareerTimeline";
import { WordRotate } from "../components/ui/word-rotate";
import profileImage from "../assets/profile.jpeg";

const name = "Daniel Robertson";

---

<Layout>
  <header class="stagger stagger-1 flex items-center justify-between pt-10 pb-4">
    <nav>
      <ul class="flex items-center gap-5">
        <li>
          <a
            href="/"
            class="nav-link text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 py-2 -my-2 px-1 -mx-1"
          >
            home
          </a>
        </li>
        <li>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 py-2 -my-2 px-1 -mx-1"
          >
            resume
          </a>
        </li>
      </ul>
    </nav>
    <ThemeToggle client:load />
  </header>

  <main id="top">
    <section class="pt-8 md:pt-16 pb-24">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div>
          <h1 class="stagger stagger-2 text-3xl md:text-4xl font-bold tracking-tight">
            {name}
          </h1>
          <div class="stagger stagger-3 mt-3 text-base text-zinc-500 dark:text-zinc-400 leading-relaxed">
            <WordRotate
              client:load
              words={[
                "Software engineer",
                "Design engineer",
                "Front-end developer",
                "Drummer",
                "Product engineer",
                "Choral singer",
              ]}
              duration={3000}
            />
          </div>
          <div class="stagger stagger-4">
            <Socials client:load />
          </div>
        </div>
        <div class="stagger stagger-2 hidden md:block shrink-0">
          <div class="inline-block p-2 rounded-[20px] bg-black/[0.03] dark:bg-white/[0.05] ring-1 ring-black/[0.05] dark:ring-white/[0.08] shadow-lg">
            <Image
              src={profileImage}
              alt={name}
              height={480}
              width={360}
              quality={90}
              class="rounded-xl w-40 outline outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="stagger stagger-5 pb-24">
      <CareerTimeline client:visible />
    </section>
  </main>
</Layout>

<style is:global>
  .nav-link {
    transition: color 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .social-link {
    transition: color 0.3s cubic-bezier(0.32, 0.72, 0, 1), scale 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .theme-toggle {
    transition: background-color 0.3s cubic-bezier(0.32, 0.72, 0, 1), scale 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .timeline-entry {
      animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
</style>
