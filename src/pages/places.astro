---
import "@fontsource-variable/outfit";
import "@/styles/globals.css";
import { getImage } from "astro:assets";
import ThemeToggle from "../components/ThemeToggle";
import Globe from "../components/Globe";
import berlin1 from "../assets/berlin1.jpg";
import lisbon1 from "../assets/lisbon1.jpg";
import london1 from "../assets/london1.jpg";
import nyc1 from "../assets/nyc1.jpg";
import paris1 from "../assets/paris1.jpg";
import seattle1 from "../assets/seattle1.jpg";
import seoul1 from "../assets/seoul1.jpg";
import tokyo1 from "../assets/tokyo1.jpg";
import amsterdam1 from "../assets/amsterdam1.jpg";
import busan1 from "../assets/busan1.jpg";
import dallas1 from "../assets/dallas1.jpg";
import miami1 from "../assets/miami1.jpg";
import montreal1 from "../assets/montreal1.jpg";
import orlando1 from "../assets/orlando1.jpg";
import san_antonio1 from "../assets/san_antonio1.jpg";
import vancouver1 from "../assets/vancouver1.jpg";
import zurich1 from "../assets/zurich1.jpg";

const name = "Daniel Robertson";

const cities = [
  { id: "seattle", location: [47.6062, -122.3321], label: "Seattle", img: seattle1, rotate: -5 },
  { id: "nyc", location: [40.7128, -74.006], label: "New York", img: nyc1, rotate: 4 },
  { id: "lisbon", location: [38.7223, -9.1393], label: "Lisbon", img: lisbon1, rotate: -3 },
  { id: "london", location: [51.5074, -0.1278], label: "London", img: london1, rotate: 6 },
  { id: "paris", location: [48.8566, 2.3522], label: "Paris", img: paris1, rotate: -4 },
  { id: "berlin", location: [52.52, 13.405], label: "Berlin", img: berlin1, rotate: 3 },
  { id: "zurich", location: [47.3769, 8.5417], label: "Zurich", img: zurich1, rotate: -4 },
  { id: "amsterdam", location: [52.3676, 4.9041], label: "Amsterdam", img: amsterdam1, rotate: 4 },
  { id: "seoul", location: [37.5665, 126.978], label: "Seoul", img: seoul1, rotate: -6 },
  { id: "busan", location: [35.1796, 129.0756], label: "Busan", img: busan1, rotate: -4 },
  { id: "tokyo", location: [35.6762, 139.6503], label: "Tokyo", img: tokyo1, rotate: 5 },
  { id: "vancouver", location: [49.2827, -123.1207], label: "Vancouver", img: vancouver1, rotate: -3 },
  { id: "montreal", location: [45.5019, -73.5674], label: "Montreal", img: montreal1, rotate: 6 },
  { id: "dallas", location: [32.7767, -96.797], label: "Dallas", img: dallas1, rotate: -5 },
  { id: "san_antonio", location: [29.4241, -98.4936], label: "San Antonio", img: san_antonio1, rotate: 3 },
  { id: "miami", location: [25.7617, -80.1918], label: "Miami", img: miami1, rotate: -4 },
  { id: "orlando", location: [28.5383, -81.3792], label: "Orlando", img: orlando1, rotate: 5 },
] as const;

const pins = await Promise.all(
  cities.map(async (c) => ({
    id: c.id,
    location: [...c.location] as [number, number],
    label: c.label,
    rotate: c.rotate,
    image: (await getImage({ src: c.img, width: 640, format: "webp" })).src,
  }))
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Places I've traveled" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} | Places</title>
    <script is:inline>
      const theme = localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body
    class="h-screen flex flex-col overflow-hidden text-zinc-900 dark:text-zinc-100 bg-zinc-50 dark:bg-zinc-900 antialiased"
  >
    <header
      class="stagger stagger-1 flex items-center justify-between px-4 sm:px-6 pt-6 pb-2 max-w-2xl w-full mx-auto"
    >
      <nav>
        <ul class="flex items-center gap-5">
          <li>
            <a
              href="/"
              class="nav-link text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 py-2 -my-2 px-1 -mx-1"
            >
              home
            </a>
          </li>
          <li>
            <span class="text-sm text-zinc-900 dark:text-zinc-100 py-2 -my-2 px-1 -mx-1">
              places
            </span>
          </li>
          <li>
            <a
              href="/resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="nav-link text-sm text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 py-2 -my-2 px-1 -mx-1"
            >
              resume
            </a>
          </li>
        </ul>
      </nav>
      <ThemeToggle client:load />
    </header>

    <main class="stagger stagger-2 flex-1 min-h-0">
      <Globe client:load pins={pins} />
    </main>
  </body>
</html>

<style is:global>
  html {
    font-family: "Outfit Variable", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background-color: rgba(168, 85, 247, 0.25);
  }

  .nav-link {
    transition: color 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .theme-toggle {
    transition: background-color 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      scale 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stagger {
      animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .stagger-1 {
      animation-delay: 0ms;
    }
    .stagger-2 {
      animation-delay: 80ms;
    }
  }
</style>
